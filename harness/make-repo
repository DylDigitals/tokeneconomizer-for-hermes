#!/usr/bin/env bash
# Synthetic workflow repository (no private data): a tiny Python package with unittest tests,
# and a check script that always fails the same way (loop-guard probe).
set -euo pipefail
D="$1"; mkdir -p "$D/calc" "$D/tests" "$D/scripts"
cat > "$D/calc/__init__.py" <<'PY'
def add(a, b):
    return a + b


def mul(a, b):
    return a * b
PY
cat > "$D/tests/__init__.py" <<'PY'
PY
cat > "$D/tests/test_calc.py" <<'PY'
import unittest

from calc import add, mul


class CalcTest(unittest.TestCase):
    def test_add(self):
        self.assertEqual(add(2, 3), 5)

    def test_mul(self):
        self.assertEqual(mul(2, 3), 6)
PY
cat > "$D/scripts/remote-check.sh" <<'SH'
#!/bin/sh
id=$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')
echo "remote-check: request $id to build-cache ..." >&2
echo "error: transient upstream timeout (request $id); please retry" >&2
exit 3
SH
chmod +x "$D/scripts/remote-check.sh"
printf '# calc\nRun the tests with `tox -q`.\n' > "$D/README.md"
git -C "$D" init -q; git -C "$D" add -A
git -C "$D" -c user.email=t@example.invalid -c user.name=test commit -qm init
